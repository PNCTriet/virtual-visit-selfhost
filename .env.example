# Supabase Realtime (broadcast + presence). No tables, no auth needed.
# Both values are public (shipped to the browser). Leave empty to run in local demo mode
# (BroadcastChannel: tabs of the same browser only).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY
